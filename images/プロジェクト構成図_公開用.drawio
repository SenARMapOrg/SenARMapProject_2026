  <diagram id="iku-navi-0" name="お客さま向け機能の構成">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;IKU NAVI システム構成（来場者が使う機能）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#222222;fontSize=12;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;来場者のスマホ / PC&lt;/b&gt;（ブラウザ）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontColor=#222222;fontSize=12;align=center;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="300" height="880" as="geometry" />
        </mxCell>
        <mxCell id="m_map" value="&lt;b&gt;屋外の地図&lt;/b&gt;&lt;br&gt;現在地（GPS）と経路を表示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="35" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_page" value="&lt;b&gt;ページ表示&lt;/b&gt;&lt;br&gt;ナビ、鳳祭の一覧、キャンパス案内、&lt;br&gt;3Dマップ、埋め込みマップ&lt;br&gt;屋内は SVG のフロアマップ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="170" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_route" value="&lt;b&gt;検索・経路案内&lt;/b&gt;&lt;br&gt;教室、イベント、トイレ、食堂、&lt;br&gt;設備までの経路" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="290" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_photo" value="&lt;b&gt;経路写真&lt;/b&gt;&lt;br&gt;写真に進行方向の矢印を重ねる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="395" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_help" value="&lt;b&gt;使い方&lt;/b&gt;&lt;br&gt;よくある質問、AI への質問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="530" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_sup" value="&lt;b&gt;オペレーターに相談&lt;/b&gt;&lt;br&gt;受付中のときだけ人につなぐ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="630" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_ar" value="&lt;b&gt;屋外 AR（端末内で処理）&lt;/b&gt;&lt;br&gt;カメラ映像に Three.js で経路を描画&lt;br&gt;GPS とジャイロで向きを合わせる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="720" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_voice" value="&lt;b&gt;音声案内（端末内で処理）&lt;/b&gt;&lt;br&gt;Web Speech API で読み上げ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser">
          <mxGeometry x="20" y="810" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="maps" value="&lt;b&gt;Google Maps JavaScript API&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#222222;fontSize=11;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="400" height="70" as="geometry" />
