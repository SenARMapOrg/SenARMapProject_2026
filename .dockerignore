# ========================
# Git & GitHub関連
# ========================
.git
.gitignore
.github

# ========================
# セキュリティ・環境依存（超重要）
# ========================
# 環境変数ファイルは絶対にイメージに含めない！
.env
.env.*
**/.env
**/.env.*

# Google Maps APIキー入り設定。
# 本番イメージには焼き込まず、nginx の entrypoint が環境変数から生成する
programs/html/navi/script/config.js

# ========================
# Python関連のキャッシュ・仮想環境
# ========================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
env/
.venv/

# ========================
# OS・エディタ関連の隠しファイル
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================
# ログ・一時ファイル
# ========================
*.log
tmp/
temp/

# ========================
# バックアップ環境の生成物（経路写真で約550MBある）
# ========================
deploy_env/backup/public/
