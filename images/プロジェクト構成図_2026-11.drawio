<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="sys" name="システム構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;IKU NAVI 本番構成&lt;/b&gt;&lt;br&gt;2026-11-15 時点（Pages 移行後・鳳祭の増設を戻したあと）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#222222;fontSize=14;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="700" height="50" as="geometry" /></mxCell><mxCell id="visitor" value="&lt;b&gt;来場者・学生&lt;/b&gt;&lt;br&gt;スマホ / PC のブラウザ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="190" height="70" as="geometry" /></mxCell><mxCell id="outside" value="&lt;b&gt;外部の利用者&lt;/b&gt;&lt;br&gt;GET で API を使う" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="327" width="190" height="60" as="geometry" /></mxCell><mxCell id="staff" value="&lt;b&gt;案内係・運営&lt;/b&gt;&lt;br&gt;管理画面 /admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="190" height="70" as="geometry" /></mxCell><mxCell id="member" value="&lt;b&gt;開発メンバー&lt;/b&gt;&lt;br&gt;写真のアップロード" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="785" width="190" height="70" as="geometry" /></mxCell><mxCell id="tooluser" value="&lt;b&gt;開発メンバー&lt;/b&gt;&lt;br&gt;IKU_NAVI_Tools&lt;br&gt;（データ作成・ルート検証）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="190" height="80" as="geometry" /></mxCell><mxCell id="cf" value="&lt;b&gt;Cloudflare&lt;/b&gt;（DNS・TLS 終端）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F6821F;fontColor=#222222;fontSize=12;align=right;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="780" height="780" as="geometry" /></mxCell><mxCell id="main" value="&lt;b&gt;Pages：iku-navi.net&lt;/b&gt;&lt;br&gt;/navi・navi1〜9・/embed・/map3d・/campus・/ohtori_events などの静的配信&lt;br&gt;&lt;b&gt;/data/*.json&lt;/b&gt;（ビルド時に書き出したグラフ・教室・写真の対応表）&lt;br&gt;&lt;b&gt;経路はブラウザの中で計算&lt;/b&gt;（shared/route-core.mjs）&lt;br&gt;_redirects：/3d/* を old-api へ 301" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="40" width="340" height="150" as="geometry" /></mxCell><mxCell id="help" value="&lt;b&gt;Pages Functions：POST /api/help-chat&lt;/b&gt;&lt;br&gt;faq.json を渡して Gemini へ中継" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="410" y="40" width="340" height="70" as="geometry" /></mxCell><mxCell id="apid" value="&lt;b&gt;api.iku-navi.net&lt;/b&gt;&lt;br&gt;同じ Pages のカスタムドメイン&lt;br&gt;Redirect Rule：/api/ 以外は iku-navi.net へ 301" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="230" width="340" height="90" as="geometry" /></mxCell><mxCell id="fn" value="&lt;b&gt;Pages Functions：GET /api/*&lt;/b&gt;&lt;br&gt;functions/api/[[path]].js&lt;br&gt;一覧（/api/all など）は /data/*.json を返す&lt;br&gt;経路・最寄りの施設は route-core.mjs で計算（ブラウザと同じ）&lt;br&gt;無料枠：1日10万回・1回 CPU 10ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="410" y="230" width="340" height="150" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;R2：cdn.iku-navi.net&lt;/b&gt;&lt;br&gt;バケット iku-navi-image&lt;br&gt;経路写真・矢印" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="420" width="340" height="80" as="geometry" /></mxCell><mxCell id="tunnel" value="&lt;b&gt;Tunnel：old-api.iku-navi.net&lt;/b&gt;&lt;br&gt;python:8000 へ転送&lt;br&gt;（/3d・ツールのルート検証・画面の予備）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="410" y="420" width="340" height="80" as="geometry" /></mxCell><mxCell id="egc" value="&lt;b&gt;Pages + Functions（Hono）&lt;/b&gt;&lt;br&gt;event-guide-counter.iku-navi.net&lt;br&gt;案内人数の集計・有人サポート" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="560" width="340" height="80" as="geometry" /></mxCell><mxCell id="egcdb" value="&lt;b&gt;D1&lt;/b&gt;&lt;br&gt;event-guide-counter-db" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="410" y="560" width="160" height="60" as="geometry" /></mxCell><mxCell id="up" value="&lt;