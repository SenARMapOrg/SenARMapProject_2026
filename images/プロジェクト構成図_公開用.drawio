<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="iku-navi-0" name="来場者が使う機能の構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;IKU NAVI システム構成（来場者が使う機能）&lt;/b&gt;&lt;br&gt;2026-11-19 時点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#222222;fontSize=13;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="600" height="40" as="geometry" /></mxCell><mxCell id="browser" value="&lt;b&gt;来場者のスマホ / PC&lt;/b&gt;（ブラウザ）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontColor=#222222;fontSize=12;align=center;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="300" height="690" as="geometry" /></mxCell><mxCell id="m_map" value="&lt;b&gt;屋外の地図&lt;/b&gt;&lt;br&gt;現在地（GPS）と経路を表示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="40" width="260" height="60" as="geometry" /></mxCell><mxCell id="m_page" value="&lt;b&gt;ページ表示&lt;/b&gt;&lt;br&gt;ナビ、鳳祭の企画一覧、キャンパス案内、&lt;br&gt;3Dマップ、埋め込みマップ&lt;br&gt;屋内は SVG のフロアマップ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="120" width="260" height="80" as="geometry" /></mxCell><mxCell id="m_help" value="&lt;b&gt;使い方（「？」ボタン）&lt;/b&gt;&lt;br&gt;よくある質問を読む" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="215" width="260" height="55" as="geometry" /></mxCell><mxCell id="m_route" value="&lt;b&gt;検索・経路案内（端末内で計算）&lt;/b&gt;&lt;br&gt;教室、イベント、トイレ、食堂、設備まで&lt;br&gt;route-core.mjs で最短経路（Dijkstra 法）&lt;br&gt;エレベーター・階段を使わない条件も" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="290" width="260" height="120" as="geometry" /></mxCell><mxCell id="m_photo" value="&lt;b&gt;経路写真&lt;/b&gt;&lt;br&gt;写真に進行方向の矢印を重ねる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="440" width="260" height="60" as="geometry" /></mxCell><mxCell id="m_ar" value="&lt;b&gt;屋外 AR（端末内で処理）&lt;/b&gt;&lt;br&gt;カメラ映像に Three.js で経路を描画&lt;br&gt;GPS とジャイロで向きを合わせる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="520" width="260" height="80" as="geometry" /></mxCell><mxCell id="m_voice" value="&lt;b&gt;音声案内（端末内で処理）&lt;/b&gt;&lt;br&gt;Web Speech API で読み上げ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="20" y="615" width="260" height="55" as="geometry" /></mxCell><mxCell id="maps" value="&lt;b&gt;Google Maps JavaScript API&lt;/b&gt;&lt;br&gt;屋外の地図" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#222222;fontSize=11;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="400" height="60" as="geometry" /></mxCell><mxCell id="cf" value="&lt;b&gt;Cloudflare&lt;/b&gt;（DNS、TLS）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F6821F;fontColor=#222222;fontSize=12;align=left;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="400" height="530" as="geometry" /></mxCell><mxCell id="pages" value="&lt;b&gt;Pages：iku-navi.net&lt;/b&gt;&lt;br&gt;HTML / CSS / JavaScript（フレームワークなし）&lt;br&gt;/navi、/ohtori_events、/campus、/map3d、/embed&lt;br&gt;/svg（フロアマップ）、/navi/faq.json&lt;br&gt;&lt;b&gt;/data/*.json&lt;/b&gt;：教室・ノード・エッジ・写真の対応表&lt;br&gt;（ビルドのときに CSV から書き出す）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="30" width="340" height="210" as="geometry" /></mxCell><mxCell id="tunnel" value="&lt;b&gt;Tunnel：old-api.iku-navi.net&lt;/b&gt;&lt;br&gt;端末内の計算が使えないときの予備" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;dashed=1;" vertex="1" parent="cf"><mxGeometry x="30" y="255" width="340" height="60" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;R2：cdn.iku-navi.net&lt;/b&gt;&lt;br&gt;経路写真の配信（約1,300枚）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="330" width="340" height="60" as="geometry" /></mxCell><mxCell id="fn" value="&lt;b&gt;Pages Functions：api.iku-navi.net&lt;/b&gt;&lt;br&gt;GET /api/*（公開の経路探索 API）&lt;br&gt;ブラウザと同じ route-core.mjs で計算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf"><mxGeometry x="30" y="420" width="340" height="85" as="geometry" /></mxCell><mxCell id="vps" value="&lt;b&gt;ConoHa VPS / Docker Swarm&lt;/b&gt;（予備・2027年1月過ぎに停止予定）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF7ED;strokeColor=#2E7D32;fontColor=#222222;fontSize=12;align=center;spacing=6;verticalAlign=top;dashed=1;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="520" height="150" as="geometry" /></mxCell><mxCell id="cfd" value="&lt;b&gt;cloudflared&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="20" y="50" width="120" height="70" as="geometry" /></mxCell><mxCell id="py" value="&lt;b&gt;python（Flask + Gunicorn）&lt;/b&gt;&lt;br&gt;以前の経路探索 API&lt;br&gt;NetworkX の双方向 Dijkstra&lt;br&gt;CSV データを同梱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="180" y="40" width="320" height="95" as="geometry" /></mxCell><mxCell id="outside" value="&lt;b&gt;外部の利用者&lt;/b&gt;&lt;br&gt;GET で経路探索 API を使う" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#222222;fontSize=11;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="600" width="520" height="70" as="geometry" /></mxCell><mxCell id="flow" value="&lt;b&gt;案内の流れ&lt;/b&gt;&lt;br&gt;1. ページを開くと、Pages から画面と /data/*.json（教室・ノード・エッジ・写真の対応表）を読み込む&lt;br&gt;2. 出発地と目的地を選ぶと、端末の中でキャンパスのグラフから最短経路を計算する（サーバーには問い合わせない）&lt;br&gt;3. 屋外の区間は Google Maps、屋内の区間は SVG のフロアマップに経路を表示する&lt;br&gt;4. 屋内は区間ごとの写真（R2）に矢印を重ね、屋外はカメラ映像に経路を重ねる（屋外 AR）。案内は音声でも読み上げる&lt;br&gt;5. 困ったときは「？」ボタンからよくある質問を読める&lt;br&gt;&lt;b&gt;読み方&lt;/b&gt;　実線：通常の通信　破線：予備（端末内の計算が使えないときだけ、old-api の Flask に聞く）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BFA100;fontColor=#222222;fontSize=11;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1420" height="150" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_map" target="maps"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0l" value="地図" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e0"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_page" target="pages"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1l" value="画面、SVG" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_help" target="pages"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2l" value="faq.json" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_route" target="pages"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3l" value="/data/*.json" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="m_route" target="tunnel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4l" value="予備" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_photo" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5l" value="写真" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="outside" target="fn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6l" value="/api/*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;startArrow=classic;" edge="1" parent="1" source="cfd" target="tunnel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7l" value="Tunnel" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;fontSize=10;fontColor=#222222;endArrow=classic;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfd" target="py"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
