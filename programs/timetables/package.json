{
  "name": "timetables",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:vite": "vite build --watch",
    "dev": "wrangler pages dev dist --compatibility-date=2026-01-01",
    "build": "vite build",
    "deploy": "vite build && wrangler pages deploy dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply timetables-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply timetables-db --remote",
    "sync-courses": "sh scripts/sync-courses.sh"
  },
  "dependencies": {
    "hono": "^4.6.9",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.0.0"
  }
}
