        <mxCell id="cf" value="&lt;b&gt;Cloudflare&lt;/b&gt;（DNS、TLS）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F6821F;fontColor=#222222;fontSize=12;align=left;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="170" width="400" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;Pages：iku-navi.net&lt;/b&gt;&lt;br&gt;HTML / CSS / JavaScript（フレームワークなし）&lt;br&gt;/navi、/ohtori_events、/campus、/map3d、/embed&lt;br&gt;/svg（フロアマップ）、/navi/faq.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="30" y="35" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tunnel" value="&lt;b&gt;Tunnel：api.iku-navi.net&lt;/b&gt;&lt;br&gt;サーバーのポートを公開せずに API へ接続" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="30" y="170" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;R2：cdn.iku-navi.net&lt;/b&gt;&lt;br&gt;経路写真の配信" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="30" y="270" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="help" value="&lt;b&gt;Pages Functions：/api/help-chat&lt;/b&gt;&lt;br&gt;API キーを隠して Gemini へ中継&lt;br&gt;faq.json の内容だけで答えるよう指示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="30" y="400" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sup" value="&lt;b&gt;Pages Functions&lt;/b&gt;&lt;br&gt;/api/support/*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="30" y="500" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;D1&lt;/b&gt;&lt;br&gt;相談内容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6821F;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="cf">
          <mxGeometry x="260" y="510" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="swarm" value="&lt;b&gt;ConoHa VPS / Docker Swarm&lt;/b&gt;（複数台に分散）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF7ED;strokeColor=#2E7D32;fontColor=#222222;fontSize=12;align=center;spacing=6;verticalAlign=top;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="250" width="560" height="310" as="geometry" />
        </mxCell>
        <mxCell id="cfd" value="&lt;b&gt;cloudflared&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="swarm">
          <mxGeometry x="20" y="95" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="py" value="&lt;b&gt;python（Flask + Gunicorn）&lt;/b&gt;&lt;br&gt;GET /api/all：教室・ノードの初期データ&lt;br&gt;GET /api/route：経路探索&lt;br&gt;GET /api/nearest_toilet、nearest_cafeteria、&lt;br&gt;nearest_facility：最寄りの設備まで&lt;br&gt;GET /api/events：鳳祭のイベント一覧&lt;br&gt;GET /api/edge_images：区間ごとの写真 URL&lt;br&gt;GET /api/graph：3Dマップ用のデータ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="swarm">
          <mxGeometry x="190" y="40" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="algo" value="&lt;b&gt;NetworkX&lt;/b&gt;&lt;br&gt;双方向 Dijkstra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="swarm">
          <mxGeometry x="190" y="240" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="csv" value="&lt;b&gt;CSV データ&lt;/b&gt;&lt;br&gt;ノード、エッジ、設備など" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;fontSize=10;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="swarm">
          <mxGeometry x="370" y="240" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Gemini API&lt;/b&gt;（Google）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#222222;fontSize=11;align=center;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="580" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;案内の流れ&lt;/b&gt;&lt;br&gt;1. ページを開くと、Pages から画面を読み込み、経路 API から教室や設備の一覧を取得する&lt;br&gt;2. 出発地と目的地を選ぶと、経路 API がキャンパスのグラフから最短経路を計算して返す&lt;br&gt;3. 屋外の区間は Google Maps、屋内の区間は SVG のフロアマップに経路を表示する&lt;br&gt;4. 屋内は区間ごとの写真に矢印を重ね、屋外はカメラ映像に経路を重ねる（屋外 AR）&lt;br&gt;5. 困ったときは、よくある質問、AI、オペレーターの順に相談できる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BFA100;fontColor=#222222;fontSize=11;align=left;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="790" width="1020" height="140" as="geometry" />
        </mxCell>
