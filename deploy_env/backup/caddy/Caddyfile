# 証明書は Caddy が Let's Encrypt などから自動で取る（80/443 を開けておくこと）

{$BACKUP_DOMAIN} {
	encode zstd gzip
	root * /srv/public/site

	# バックアップなので検索結果には出さない
	header X-Robots-Tag "noindex"
	header /navi/script/config.js Cache-Control "no-cache"
	@assets path /svg/* /images/*
	header @assets Cache-Control "public, max-age=86400"

	# 本番の _redirects と同じ転送
	redir /3d https://api.{$BACKUP_DOMAIN}/3d/ 301
	redir /3d/* https://api.{$BACKUP_DOMAIN}{uri} 301

	# AIチャットは Cloudflare Pages Functions でしか動かない
	handle /api/help-chat {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"バックアップ環境ではAIチャットを使えません"}` 503
	}

	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

api.{$BACKUP_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex"
	reverse_proxy python:8000
}

cdn.{$BACKUP_DOMAIN} {
	root * /srv/public/cdn
	# 矢印画像はナビ画面の JS が別オリジンとして読む
	header Access-Control-Allow-Origin "*"
	header Cache-Control "public, max-age=86400"
	header X-Robots-Tag "noindex"
	file_server
}
